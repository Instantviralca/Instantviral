# InstantViral — Production Environment Template
# =============================================================================
# Contabo VPS + Nginx + PM2 + Cloudflare.
# Copy values into the host env file used by PM2 (never commit real secrets).
#
# Full guide: DEPLOYMENT.md + docs/PRODUCTION_DEPLOYMENT_GUIDE.md
# Verify (with secrets loaded, not committed):
#   IV_VERIFY_AS_PRODUCTION=1 npm run env:verify
# =============================================================================

# ── Site (required) ──────────────────────────────────────────────────────────
# Public HTTPS origin — used for Mollie return/cancel URLs, emails, absolute URLs.
NEXT_PUBLIC_SITE_URL=https://instantviral.ca

# Checkout lives on the main domain at /checkout (no separate checkout origin).
# Optional: retired checkout subdomain hostname for permanent redirects only:
# NEXT_PUBLIC_LEGACY_CHECKOUT_HOST=checkout.instantviral.ca
# Do not set NEXT_PUBLIC_CHECKOUT_URL for customer traffic (deprecated).

# ── Database (required) ──────────────────────────────────────────────────────
# Contabo local Postgres example:
# DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5433/instantviral
DATABASE_URL=

# Mollie Remote / CarryCubes (Admin → Settings can override)
# MOLLIE_REMOTE_SERVER_URL=https://carrycubes.com
# MOLLIE_REMOTE_SHARED_SECRET=
# REMOTE_PAYMENT_WEBSITE_URL=https://carrycubes.com

# ── Admin auth (required) ────────────────────────────────────────────────────
# Obtain: generate yourself — do NOT use change-me-admin or other defaults
#   openssl rand -base64 32
IV_ADMIN_PASSWORD=

# Obtain: generate a random 64+ character secret
#   openssl rand -hex 64
IV_ADMIN_SESSION_SECRET=

# Optional public flag so the UI knows admin login is configured
NEXT_PUBLIC_ADMIN_AUTH_CONFIGURED=true

# ── Email (required) ─────────────────────────────────────────────────────────
# Prefer Contabo / self-hosted SMTP:
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=

# Optional Resend if SMTP is unset (SMTP wins when both are set):
# RESEND_API_KEY=

# Strongly recommended
EMAIL_ADMIN_TO=
EMAIL_SUPPORT=
EMAIL_COMPANY_NAME=InstantViral

# ── Do NOT set in production ─────────────────────────────────────────────────
# IV_PAYMENTS_MODE=mock
# IV_ALLOW_FILE_STORE=1
# IV_SKIP_ENV_GUARD=1
# IV_PERSISTENCE=memory

# ── Optional analytics (Document 14.09) ───────────────────────────────────────
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_ANALYTICS_DEBUG=false
# NEXT_PUBLIC_ANALYTICS_CONSENT_MODE=required
# NEXT_PUBLIC_GA4_ENABLED=false
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ENABLED=false
# NEXT_PUBLIC_GTM_CONTAINER_ID=
# NEXT_PUBLIC_CLARITY_ENABLED=false
# NEXT_PUBLIC_CLARITY_PROJECT_ID=

# ── Optional Learn preview ───────────────────────────────────────────────────
# LEARN_ARTICLE_PREVIEW_SECRET=

# ── Abandoned cart cron ──────────────────────────────────────────────────────
# ABANDONED_CART_CRON_SECRET=
# Schedule on Contabo: npm run abandoned-carts:process (Linux cron / PM2)
