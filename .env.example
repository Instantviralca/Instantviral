# Environment placeholders (fill in for local/production)
# Never commit .env.local
# Full runbook: DEPLOYMENT.md
#
# Contabo note (future — do not migrate yet):
# - DATABASE_URL will point at local Postgres on the VPS
# - SMTP_* will point at Contabo SMTP / local mail
# - No Neon or Resend required for abandoned cart / transactional mail

# ── Site (HTTPS required in production) ───────────────
# NEXT_PUBLIC_SITE_URL=https://instantviral.ca
# SITE_URL=https://instantviral.ca

# Checkout is always on the main domain: /checkout
# Do NOT set a separate customer checkout origin.
# Optional: keep legacy host for 308 redirects from old checkout subdomain emails/bookmarks:
# NEXT_PUBLIC_LEGACY_CHECKOUT_HOST=checkout.instantviral.ca
# (NEXT_PUBLIC_CHECKOUT_URL is deprecated — treated only as a legacy redirect hint)
# ── Database (standard PostgreSQL) ────────────────────
# Any Postgres that accepts a normal connection string (current host now;
# future Contabo example: postgresql://USER:PASSWORD@127.0.0.1:5432/instantviral)
# DATABASE_URL=postgresql://user:pass@host:5432/dbname

# Dev-only file store fallback (never in production)
# IV_ALLOW_FILE_STORE=1

# Force in-memory persistence (tests)
# IV_PERSISTENCE=memory

# ── Admin auth ────────────────────────────────────────
# Prefer strong unique values in production (aliases: ADMIN_PASSWORD, SESSION_SECRET)
# IV_ADMIN_PASSWORD=
# IV_ADMIN_SESSION_SECRET=
# IV_SHARED_SECRET=
# NEXT_PUBLIC_ADMIN_AUTH_CONFIGURED=true

# ── Mollie Remote Payment (active — Stripe paused) ──
# MOLLIE_REMOTE_SERVER_URL=https://carrycubes.com
# MOLLIE_REMOTE_SHARED_SECRET=must-match-server-plugin-min-16-chars
# MOLLIE_PRODUCT_NAME=Cubes
# REMOTE_PAYMENT_WEBSITE_URL=https://carrycubes.com   # alias used by Admin → Settings

# ── Stripe (paused — enable in config/payments.ts when ready) ──
# STRIPE_SECRET_KEY=sk_...
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_...
# STRIPE_WEBHOOK_SECRET=whsec_...

# ── Remote payment (legacy — disabled) ───────
# Admin → Settings preferred for Mollie server URL
# Local mock payments (non-production only):
# IV_PAYMENTS_MODE=mock

# ── Transactional email (provider-neutral) ────────────
# Preferred (Contabo / self-hosted SMTP):
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=orders@your-domain.com
# EMAIL_FROM_NAME=InstantViral
# EMAIL_SUPPORT=support@your-domain.com
# EMAIL_ADMIN_TO=ops@your-domain.com
# EMAIL_COMPANY_NAME=InstantViral

# Temporary Vercel-period adapter (optional while SMTP is unset):
# RESEND_API_KEY=re_...
# RESEND_FROM_EMAIL=orders@your-verified-domain.com   # alias for EMAIL_FROM
# When both SMTP and Resend are set, SMTP wins.

# ── Analytics — Document 14.09 ────────────────────────
# First-party (primary business reporting — Contabo-portable)
# ANALYTICS_ENABLED=true
# ANALYTICS_SESSION_TIMEOUT_MINUTES=30
# ANALYTICS_EVENT_RETENTION_DAYS=180
# After deploy: apply drizzle/0003_analytics_events.sql and drizzle/0006_analytics_sessions.sql

# Optional browser master switch / external providers (NOT the source of truth)
# NEXT_PUBLIC_ANALYTICS_ENABLED=true
# NEXT_PUBLIC_ANALYTICS_DEBUG=false
# NEXT_PUBLIC_ANALYTICS_CONSENT_MODE=required
# NEXT_PUBLIC_GA4_ENABLED=false
# NEXT_PUBLIC_GA4_MEASUREMENT_ID=
# NEXT_PUBLIC_GTM_ENABLED=false
# NEXT_PUBLIC_GTM_CONTAINER_ID=
# NEXT_PUBLIC_CLARITY_ENABLED=false
# NEXT_PUBLIC_CLARITY_PROJECT_ID=
# Meta Pixel / TikTok Pixel: not implemented (extensible later)

# Learn article preview (authorized editors only — Document 15.02)
# LEARN_ARTICLE_PREVIEW_SECRET=

# Skip production env throw during instrumentation (CI / build only)
# IV_SKIP_ENV_GUARD=1

# Geo block (PK, IN, BD, NG) — disable for local/preview if needed
# IV_GEO_BLOCK_DISABLED=1

# After deploy, apply pending drizzle/*.sql (npm run db:migrate:sql).

# ── Abandoned cart recovery (provider-neutral) ────────
# Shared secret for /api/jobs/abandoned-carts (Vercel Cron bearer, or Contabo curl)
# CRON_SECRET=
# ABANDONED_CART_CRON_SECRET=   # alias preferred for Contabo/Linux cron
# ABANDONED_CART_TOKEN_SECRET=  # optional HMAC secret for recovery links
# Timing overrides (minutes):
# ABANDONED_CART_INACTIVITY_MINUTES=60
# ABANDONED_CART_EMAIL_1_DELAY_MINUTES=60
# ABANDONED_CART_EMAIL_2_DELAY_MINUTES=1440
# ABANDONED_CART_EMAIL_3_DELAY_MINUTES=4320
# ABANDONED_CART_TOKEN_TTL_DAYS=14
# ABANDONED_CART_RETENTION_DAYS=90
# Contabo later: schedule `npx tsx scripts/process-abandoned-carts.ts` via Linux cron/PM2.
